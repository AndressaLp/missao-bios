; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes below [section] heading
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Missão Bios"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="MissaoBios"

[autoload]

GameManager="*res://scripts/Managers/GameManager.cs"
PuzzleManager="*res://scripts/Managers/PuzzleManager.cs"
DialogueManager="*res://scripts/Managers/DialogueManager.cs"
SaveManager="*res://scripts/Managers/SaveManager.cs"
UIManager="*res://scripts/Managers/UIManager.cs"
AudioManager="*res://scripts/Managers/AudioManager.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
